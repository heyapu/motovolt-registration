# Copy to .env.local. Never commit the completed file.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN
# Generate each secret independently: openssl rand -hex 32
OTP_HMAC_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
CRON_SECRET=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_SECRET
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=YOUR_AUTH_KEY
MSG91_TEMPLATE_ID=YOUR_APPROVED_SENDOTP_TEMPLATE_ID
# SendOTP: six-digit custom code; 10-minute expiry matching the existing approved template.
# Rolling 24-hour cap across all dealers. No SMS is sent above this cap.
OTP_DAILY_SEND_LIMIT=1000
SHEETS_ENABLED=true
GOOGLE_SHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SHEET_TAB=Test Rides
# Entire service-account JSON on one line; keep its private_key \n escapes.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# Local development ONLY. Never set true on production or a shared preview.
DEMO_MODE=false
